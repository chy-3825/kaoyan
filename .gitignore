# Signing keys and credentials (keep private backups outside Git)
**/signing/
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
.env
.env.*
!.env.example
**/password
**/password.*
**/secrets.json
**/credentials.json
local.properties
# Generated builds and packages
**/build/
**/.gradle/
*.apk
*.aab
*.idsig
*.apk.sha256
# Local dependencies and caches
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.pytest_cache/
.cache/
# Local previews, IDE files and logs
tmp-preview/
*.log
.idea/
.vscode/
.DS_Store

# User-requested installable APKs; signing material stays excluded.
!apk/*.apk
